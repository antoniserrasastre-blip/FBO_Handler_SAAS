# ─────────────────────────────────────────────────────────────
# Variables de entorno para despliegue en Railway
# Copia estas claves al panel de Variables de cada service.
# ─────────────────────────────────────────────────────────────

# ── Service: fbo-handler (Next.js, raíz) ─────────────────────

# Turso (producción)
TURSO_DATABASE_URL="libsql://tu-db.turso.io"
TURSO_AUTH_TOKEN="tu-token-aqui"

# Prisma CLI (no se usa en runtime de Railway, pero el build lo lee)
DATABASE_URL="file:./dev.db"

# NextAuth.js
# Genera con: openssl rand -base64 48
NEXTAUTH_SECRET="cambiar-en-produccion"
# Railway expone ${{RAILWAY_PUBLIC_DOMAIN}} — úsalo como referencia
NEXTAUTH_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# Cifrado AES-256-GCM para PII (pasaportes, tripulación) — v2.
# Genera con: openssl rand -base64 32  (debe decodificar a 32 bytes exactos)
# IMPORTANTE: si ya existen datos cifrados en otra instancia, usa LA MISMA clave;
# perderla = pérdida permanente de los datos descifrados.
PASSPORT_ENCRYPTION_KEY=""

# Live tracking OpenSky — durante v2 conviene desactivar para no ensuciar logs
# ni gastar cuota mientras el poller está en stub.
OPENSKY_DISABLED="true"

# Protección de /api/setup (creación del primer admin)
SETUP_SECRET=""

# Passwords iniciales (solo seed inicial vía /api/setup)
SEED_ADMIN_PASSWORD=""
SEED_SUPERVISOR_PASSWORD=""
SEED_HANDLER_PASSWORD=""
SEED_VIEWER_PASSWORD=""

# URL interna del microservicio PDF (red privada de Railway).
# Asume que el segundo service se llama "pdf-microservice".
PDF_MICROSERVICE_URL="http://pdf-microservice.railway.internal:3001"


# ── Service: pdf-microservice (Express) ──────────────────────

# Railway inyecta PORT automáticamente; el server.js lo respeta.
# No hace falta definir nada extra salvo que quieras forzarlo:
# PORT=3001
