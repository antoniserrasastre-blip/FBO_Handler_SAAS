{
  "name": "fbo-aena-microservice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express microservice that computes AENA aerodrome fees (LEPA) for movements coming from the FBO Handler SAAS app.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
