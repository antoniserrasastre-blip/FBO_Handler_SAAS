# aena-microservice
# Port to listen on (default 3002).
PORT=3002

# Shared bearer token expected on every non-/health request.
# The Next.js platform sends it as `Authorization: Bearer <token>`.
# Leave empty to disable auth (dev only).
AENA_MICROSERVICE_AUTH=

# SQLite file path (default ./data/aena.db).
AENA_DB_PATH=./data/aena.db
