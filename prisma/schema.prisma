generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      String     @default("HANDLER") // ADMIN | HANDLER
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  eventLogs EventLog[]
}

model DaySheet {
  id        String   @id @default(cuid())
  date      DateTime @unique
  flights   Flight[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flight {
  id             String         @id @default(cuid())
  daySheetId     String
  daySheet       DaySheet       @relation(fields: [daySheetId], references: [id], onDelete: Cascade)
  callsign       String
  registration   String
  aircraftType   String
  origin         String?
  eta            String?        // HH:MM
  arrivalDate    String?        // DD/MM
  destination    String?
  etd            String?        // HH:MM
  departureDate  String?        // DD/MM
  parking        String?
  tobt           String?
  state          String         @default("EXPECTED") // EXPECTED | ON_GROUND | BOARDING | DISPATCHED

  // Arrival counts (estimated from import, real from handler)
  crewArrival    Int            @default(0)
  crewArrivalReal Int?
  paxArrival     Int            @default(0)
  paxArrivalReal Int?

  // Departure counts (estimated from import, real from handler)
  crewDeparture  Int            @default(0)
  crewDepartureReal Int?
  paxDeparture   Int            @default(0)
  paxDepartureReal Int?

  // Arrival passenger details
  paxArrBagsChecked    Int      @default(0)
  paxArrBagsCabin      Int      @default(0)
  paxArrBagsState      String   @default("IN_AIRCRAFT") // IN_AIRCRAFT | UNLOADED | DELIVERED
  paxArrTransportType  String   @default("UNDEFINED") // RENTAL_CAR | PREPARED_CAR | TAXI | UNDEFINED
  paxArrTransportState String   @default("PENDING") // PENDING | CONFIRMED
  paxArrState          String   @default("IN_AIRCRAFT") // IN_AIRCRAFT | IN_LOUNGE | COMPLETED

  // Departure passenger details
  paxDepBagsChecked    Int      @default(0)
  paxDepBagsCabin      Int      @default(0)
  paxDepBagsState      String   @default("NOT_ARRIVED") // NOT_ARRIVED | TAGGED | SENT_TO_AIRCRAFT
  paxDepTransportType  String   @default("UNDEFINED")
  paxDepTransportState String   @default("PENDING")
  paxDepState          String   @default("NOT_ARRIVED") // NOT_ARRIVED | IN_LOUNGE | BOARDED

  // Crew details
  crewArrLocation      String   @default("IN_AIRCRAFT") // IN_AIRCRAFT | IN_LOUNGE
  crewDepLocation      String   @default("IN_AIRCRAFT")

  // Fuel
  fuelState      String         @default("NOT_REQUESTED") // NOT_REQUESTED | REQUESTED | SERVED
  fuelRequestedAt String?
  fuelServedAt   String?

  // Toilet
  toiletState    String         @default("NOT_REQUESTED") // NOT_REQUESTED | REQUESTED | COMPLETED
  toiletRequestedAt String?
  toiletCompletedAt String?

  // Overnight link: if this flight is a departure copy of an arrival on another day
  linkedFlightId String?

  services       Service[]
  eventLogs      EventLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([daySheetId])
}

model Service {
  id          String   @id @default(cuid())
  flightId    String
  flight      Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  type        String   // CATERING | DISHES | COOLER_BAG | STORAGE_BAG | LAUNDRY | THERMOS | NEWSPAPERS | CUSTOM
  customName  String?
  reference   String?  // Order/reference number (e.g., NJE catering ref)
  target      String?  // CREW | PAX (for catering distinction)
  state       String   @default("PENDING") // PENDING | ARRIVED | DELIVERED
  origin      String?  // Crossroads / Catering Aire / Otro
  arrivedAt   String?  // When the item arrived at FBO
  deliveredAt String?  // When delivered to the aircraft

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flightId])
}

model EventLog {
  id        String   @id @default(cuid())
  flightId  String
  flight    Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())

  @@index([flightId])
  @@index([userId])
}
