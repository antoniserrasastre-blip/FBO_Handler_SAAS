generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Identity
// ============================================================================

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      String     @default("HANDLER") // ADMIN | SUPERVISOR | HANDLER | VIEWER
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  eventLogs EventLog[]
}

// ============================================================================
// DaySheet — opt-in row for days the supervisor wants to materialise
// (e.g. prepare tomorrow before any Visit is imported). When absent, the
// day still appears in /historico derived from Visit.palmaDay. When present
// the row may carry day-level metadata (notes for now; closed flag reserved).
// ============================================================================

model DaySheet {
  id        String   @id @default(cuid())
  date      DateTime @unique  // UTC midnight of Palma-local date
  notes     String?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ============================================================================
// Core domain: Operator → Aircraft → Visit → Movement
// ============================================================================

model Operator {
  id          String       @id @default(cuid())
  icaoCode    String       @unique           // "NJE", "VJT", "EJU", …
  name        String
  aircraft    Aircraft[]
  visits      Visit[]
  crewMembers CrewMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Aircraft {
  id                 String    @id @default(cuid())
  registration       String    @unique         // "EC-MIL", "CS-PHF"
  aircraftType       String?
  currentOperatorId  String?
  currentOperator    Operator? @relation(fields: [currentOperatorId], references: [id])
  baseAirport        String?
  visits             Visit[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([currentOperatorId])
}

model Visit {
  id            String   @id @default(cuid())
  aircraftId    String
  aircraft      Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  operatorId    String?
  operator      Operator? @relation(fields: [operatorId], references: [id])

  // The Palma operating day this visit belongs to (UTC midnight of Palma-local date).
  // For OVERNIGHT visits this is the arrival day; the departure can fall on a later day.
  palmaDay      DateTime

  type          String?  // TURNAROUND | OVERNIGHT | null when not yet known
  arrivalDate   DateTime? // UTC date of actual arrival (nullable: orphan visits from extras-first import)
  departureDate DateTime? // UTC date of actual departure
  notes         String?

  movements   Movement[]
  services    Service[]
  lostItems   LostItem[]
  eventLogs   EventLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([aircraftId])
  @@index([palmaDay])
  @@index([operatorId])
}

model Movement {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  direction   String   // ARRIVAL | DEPARTURE
  callsign    String
  origin      String?  // ARRIVAL: from-airport ; DEPARTURE: null
  destination String?  // DEPARTURE: to-airport ; ARRIVAL: null

  // Scheduled date (UTC midnight of Palma-local date) for this leg.
  // ARRIVAL.scheduledDate may differ from DEPARTURE.scheduledDate (overnight).
  scheduledDate DateTime

  // Zulu (UTC) times as HH:MM (kept as string for parity with current PDF format)
  eta         String?  // only on ARRIVAL
  etd         String?  // only on DEPARTURE
  ata         String?  // actual time of arrival (handler override, HH:MM Zulu)
  atd         String?  // actual time of departure (handler override, HH:MM Zulu)

  parking     String?
  tobt        String?
  state       String   @default("EXPECTED") // EXPECTED | ON_BLOCKS | PARKED | TURNAROUND | BOARDING | OFF_BLOCKS

  // Counts (estimated from import, real from handler)
  paxCount         Int  @default(0)
  paxCountReal     Int?
  crewCount        Int  @default(0)
  crewCountReal    Int?

  // Pax flow
  paxState         String   @default("IN_AIRCRAFT")    // ARRIVAL: IN_AIRCRAFT|IN_LOUNGE|COMPLETED ; DEPARTURE: NOT_ARRIVED|IN_LOUNGE|BOARDED
  bagsState        String   @default("IN_AIRCRAFT")    // ARRIVAL: IN_AIRCRAFT|UNLOADED|DELIVERED ; DEPARTURE: NOT_ARRIVED|TAGGED|SENT_TO_AIRCRAFT
  bagsChecked      Int      @default(0)
  bagsCabin        Int      @default(0)
  transportType    String   @default("UNDEFINED")
  transportState   String   @default("PENDING")
  crewLocation     String   @default("IN_AIRCRAFT")

  // NetJets ALS metadata (also general external ref)
  rqstNumber       String?                              // "12297037" — for idempotent re-import
  flightCategory   String   @default("COMMERCIAL")      // COMMERCIAL | FERRY | CANCELLED
  modifiedFlag     Boolean  @default(false)
  petCount         Int      @default(0)

  // Fuel / Toilet on the DEPARTURE leg
  fuelState        String   @default("NOT_REQUESTED")   // NOT_REQUESTED | REQUESTED | SERVED
  fuelRequestedAt  String?
  fuelServedAt     String?
  toiletState      String   @default("NOT_REQUESTED")   // NOT_REQUESTED | REQUESTED | COMPLETED
  toiletRequestedAt String?
  toiletCompletedAt String?

  passengers       Passenger[]
  crewAssignments  CrewAssignment[]
  eventLogs        EventLog[]

  // OpenSky live-tracking snapshot (last seen). Nullable until first match.
  liveIcao24       String?
  livePhase        String?    // APPROACHING | LANDED | ON_BLOCKS | DEPARTED
  liveLastSeenAt   DateTime?
  liveOnGround     Boolean?
  liveAltitudeM    Float?
  liveVelocityMs   Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([visitId, direction])  // 1 ARRIVAL + 1 DEPARTURE max per visit
  @@index([rqstNumber])
  @@index([scheduledDate])
  @@index([liveIcao24])
}

// ============================================================================
// Services (extras: catering, prensa, GPU, fuel, toilet, …)
// ============================================================================

model Service {
  id              String   @id @default(cuid())
  visitId         String
  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)

  type            String   // CATERING | DISHES | COOLER_BAG | STORAGE_BAG | LAUNDRY | THERMOS | NEWSPAPERS | WATER | GPU | ICE | CUSTOM
  direction       String   @default("DEPARTURE") // ARRIVAL | DEPARTURE | BOTH
  customName      String?
  reference       String?              // NJE order #
  target          String?              // CREW | PAX
  origin          String?              // NETJETS | CATERING_AIRE | MCR | OTHER
  quantity        Int      @default(1)
  rawDescription  String?              // raw text from Excel — auditing
  state           String   @default("PENDING") // PENDING | ARRIVED | DELIVERED | CANCELLED
  arrivedAt       String?
  deliveredAt     String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([visitId])
}

// ============================================================================
// People (passengers ephemeral, crew persistent — both encrypted)
// ============================================================================

model Passenger {
  id               String   @id @default(cuid())
  movementId       String
  movement         Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  givenNames       String?
  surname          String?
  fullNameHash     String?              // SHA-256 for idempotent upsert (movementId + hash)

  passportEncrypted String?             // AES-256-GCM
  passportHash     String?              // SHA-256 — lookup / dedupe
  passportType     String?              // NID | PP
  passportCountry  String?
  passportExpiry   String?              // yyyy-mm-dd

  dobEncrypted     String?
  gender           String?              // M | F
  nationality      String?

  status           String   @default("CONFIRMED") // CONFIRMED | NO_SHOW | ADDED
  unmatched        Boolean  @default(false)       // NetJets parser flag
  verified         Boolean  @default(false)
  source           String   @default("MANUAL")    // NETJETS | VISTAJET | EJU | GENDEC_PASTE | MANUAL
  corrections      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([movementId])
  @@index([movementId, passportHash])
}

model CrewMember {
  id                String   @id @default(cuid())
  operatorId        String
  operator          Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  givenNames        String?
  surname           String?
  fullName          String

  passportEncrypted String?              // AES-256-GCM
  passportHash      String?              // SHA-256

  passportType      String?              // NID | PP
  passportCountry   String?
  passportExpiry    String?

  dobEncrypted      String?
  gender            String?
  nationality       String?
  role              String   @default("OTHER") // CAPTAIN | FIRST_OFFICER | CABIN_CREW | OTHER
  active            Boolean  @default(true)

  assignments       CrewAssignment[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([operatorId, passportHash])
  @@index([operatorId])
}

model CrewAssignment {
  movementId    String
  movement      Movement   @relation(fields: [movementId], references: [id], onDelete: Cascade)
  crewMemberId  String
  crewMember    CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  roleOnFlight  String     @default("OTHER") // CAPTAIN | FIRST_OFFICER | CABIN_CREW | OTHER
  createdAt     DateTime   @default(now())

  @@id([movementId, crewMemberId])
  @@index([crewMemberId])
}

// ============================================================================
// Misc
// ============================================================================

model LostItem {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  description String
  location    String   // AIRCRAFT | LOUNGE | RAMP
  state       String   @default("FOUND") // FOUND | CLAIMED | DELIVERED
  foundAt     String?
  claimedAt   String?
  deliveredAt String?
  claimedBy   String?
  createdAt   DateTime @default(now())

  @@index([visitId])
}

model EventLog {
  id          String    @id @default(cuid())
  visitId     String?
  visit       Visit?    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  movementId  String?
  movement    Movement? @relation(fields: [movementId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String
  details     String?
  timestamp   DateTime  @default(now())

  @@index([visitId])
  @@index([movementId])
  @@index([userId])
}
