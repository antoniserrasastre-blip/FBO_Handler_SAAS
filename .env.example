# Turso Database (produccion)
TURSO_DATABASE_URL="libsql://tu-db.turso.io"
TURSO_AUTH_TOKEN="tu-token-aqui"

# Prisma (SQLite local para CLI de Prisma)
DATABASE_URL="file:./dev.db"

# NextAuth.js
# Genera tu propio secret con: openssl rand -base64 48
NEXTAUTH_SECRET="tu-secret-aqui"
# En local: http://localhost:3000 | En Vercel: https://tu-proyecto.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# /api/setup proteccion: la ruta solo se ejecuta si la cabecera X-Setup-Secret
# coincide con este valor. Si no esta configurado, la ruta devuelve 500.
SETUP_SECRET=""

# Passwords iniciales (solo usados al sembrar via /api/setup).
# Si no se definen, el usuario correspondiente NO se siembra.
SEED_ADMIN_PASSWORD=""
SEED_HANDLER_PASSWORD=""
SEED_VIEWER_PASSWORD=""

# =============================================================================
# v2 — Passenger / Crew PII encryption
# =============================================================================
# AES-256-GCM key for passport/DOB encryption. 32 raw bytes, base64-encoded.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means losing access to all encrypted PII. Back it up.
PASSPORT_ENCRYPTION_KEY=""

# =============================================================================
# v2 — NetJets / VistaJet / etc. PDF microservice
# =============================================================================
# Base URL of the Express microservice that parses ALS handler PDFs.
# Local: http://localhost:3001
# Prod (via Cloudflare Tunnel): https://sirvici.your-tunnel.cfargotunnel.com
PDF_MICROSERVICE_URL="http://localhost:3001"

# Optional bearer token for authenticating against the microservice.
PDF_MICROSERVICE_AUTH=""

# =============================================================================
# Misc
# =============================================================================
# Set to "safe-mode" to pause Cybermax PDF imports without a redeploy.
PDF_PARSER=""
