# Turso Database (produccion)
TURSO_DATABASE_URL="libsql://tu-db.turso.io"
TURSO_AUTH_TOKEN="tu-token-aqui"

# Prisma (SQLite local para CLI de Prisma)
DATABASE_URL="file:./dev.db"

# NextAuth.js
# Genera tu propio secret con: openssl rand -base64 48
NEXTAUTH_SECRET="tu-secret-aqui"
# En local: http://localhost:3000 | En Vercel: https://tu-proyecto.vercel.app
NEXTAUTH_URL="http://localhost:3000"
